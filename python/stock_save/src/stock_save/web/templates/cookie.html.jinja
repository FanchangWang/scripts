{% extends "base.html.jinja" %}
{% block title %}Cookie 管理 - 股票数据服务{% endblock %}
{% block extra_css %}
.page-head { margin-bottom: 22px; }
.page-head h1 { font-size: clamp(23px, 5vw, 29px); margin: 0; }
.card {
    background: var(--surface); border: 1px solid var(--border-soft);
    border-radius: var(--radius); padding: clamp(20px, 4vw, 30px);
    max-width: 540px; box-shadow: var(--shadow);
}
.field { margin-bottom: 18px; }
.field label {
    display: block; font-size: 13px; color: var(--text-dim);
    margin-bottom: 8px; font-family: var(--mono); font-weight: 600;
}
.field input {
    width: 100%; padding: 11px 13px; font-size: 14px; font-family: var(--mono);
    color: var(--text); background: #fbfcfe;
    border: 1px solid #7d8a9c; border-radius: var(--radius-sm);
    transition: border-color .18s ease, box-shadow .18s ease;
}
.field input::placeholder { color: var(--text-faint); }
.field input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
.actions { display: flex; gap: 10px; margin-top: 6px; }
button {
    flex: 1; padding: 11px; font-size: 14px; font-weight: 600;
    border-radius: var(--radius-sm); cursor: pointer;
    border: 1px solid transparent; transition: filter .18s ease, transform .1s ease;
    font-family: inherit;
}
button:active { transform: translateY(1px); }
button:hover { filter: brightness(1.06); }
button:disabled { opacity: .55; cursor: wait; }
.btn-primary { background: var(--accent); color: #ffffff; }
.btn-ghost { background: var(--surface-2); color: var(--text); border-color: var(--border); }
#result {
    margin-top: 18px; padding: 12px 14px; border-radius: var(--radius-sm);
    font-size: 14px; display: none; line-height: 1.65;
}
.ok { background: #e7f6ec; color: #14532d; border: 1px solid #86cfa1; }
.bad { background: #fdeaea; color: #8a1c1c; border: 1px solid #e59a9a; }
.hint { color: var(--text-dim); font-size: 13px; margin: 16px 0 0; line-height: 1.7; }
.hint code { font-family: var(--mono); color: var(--text); background: var(--surface-2); padding: 1px 5px; border-radius: 4px; }
@media (max-width: 420px) { .actions { flex-direction: column; } }
{% endblock %}
{% block content %}
<div class="page-head rise">
    <div class="eyebrow">Settings / Credentials</div>
    <h1>Cookie 管理</h1>
</div>
<div class="card rise" style="animation-delay: .06s">
    <div class="field">
        <label for="xq_a_token">xq_a_token</label>
        <input id="xq_a_token" type="text" placeholder="粘贴 xq_a_token" autocomplete="off" spellcheck="false">
    </div>
    <div class="field">
        <label for="u">u</label>
        <input id="u" type="text" placeholder="粘贴 u" autocomplete="off" spellcheck="false">
    </div>
    <div class="actions">
        <button class="btn-primary" id="saveBtn" onclick="saveCookie()">保存</button>
        <button class="btn-ghost" id="testBtn" onclick="testCookie()">测试连接</button>
    </div>
    <div id="result" role="status" aria-live="polite"></div>
    <p class="hint">凭证仅保存在服务端 <code>config/cookie.json</code>，不会写入仓库。测试通过且当天数据未落盘时，会自动保存一次。</p>
</div>
{% endblock %}
{% block extra_js %}
<script>
function getVal(id) { return document.getElementById(id).value.trim(); }
function showResult(ok, msg) {
    const el = document.getElementById('result');
    el.style.display = 'block';
    el.className = ok ? 'ok' : 'bad';
    el.textContent = msg;
}
async function saveCookie() {
    const body = {};
    const xq = getVal('xq_a_token'), u = getVal('u');
    if (xq) body.xq_a_token = xq;
    if (u) body.u = u;
    try {
        const r = await fetch('/api/cookie', {
            method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
        });
        if (!r.ok) throw new Error('HTTP ' + r.status);
        showResult(true, '✓ 已保存');
    } catch (e) { showResult(false, '保存失败：' + e.message); }
}
async function testCookie() {
    const btn = document.getElementById('testBtn');
    btn.disabled = true; btn.textContent = '测试中…';
    try {
        const body = {};
        const xq = getVal('xq_a_token'), u = getVal('u');
        if (xq) body.xq_a_token = xq;
        if (u) body.u = u;
        const r = await fetch('/api/cookie/test', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
        });
        const d = await r.json();
        if (d.valid) {
            let msg = '✓ 有效 · 最新数据 ' + d.date;
            if (d.save_status) msg += ' · ' + d.save_status;
            showResult(true, msg);
        } else {
            showResult(false, '✗ ' + (d.error || '无效'));
        }
    } catch (e) { showResult(false, '网络错误：' + e.message); }
    finally { btn.disabled = false; btn.textContent = '测试连接'; }
}
</script>
{% endblock %}
