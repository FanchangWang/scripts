<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <title>{% block title %}股票数据服务{% endblock %}</title>
    <style>
        :root {
            /* 浅色主题：所有文字对背景 >= 4.5:1（正文），次要文字也远超标准 */
            --bg: #f4f6f9;
            --surface: #ffffff;
            --surface-2: #eef1f6;
            --border: #cbd3de;
            --border-soft: #dde3eb;
            --text: #141b26;
            --text-dim: #3f4b5e;
            --text-faint: #566173;
            --accent: #b45309;
            --accent-ink: #ffffff;
            --accent-soft: rgba(180, 83, 9, .10);
            --up: #c62828;
            --down: #1b8a3c;
            --radius: 12px;
            --radius-sm: 8px;
            --shadow: 0 6px 24px rgba(20, 27, 38, .08);
            --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
            --mono: ui-monospace, SFMono-Regular, "SF Mono", "Cascadia Code", Consolas, "Liberation Mono", monospace;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
            font-family: var(--sans);
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            font-size: 15px;
        }
        /* 顶部一条极淡的渐变，制造层次但不干扰可读性 */
        body::before {
            content: "";
            position: fixed; inset: 0 0 auto 0; height: 240px;
            pointer-events: none; z-index: 0;
            background: linear-gradient(180deg, rgba(180, 83, 9, .05), transparent);
        }
        .app-nav {
            position: relative; z-index: 2;
            flex: 0 0 auto;
            display: flex; align-items: center; gap: 6px;
            padding: 11px clamp(14px, 4vw, 32px);
            background: var(--surface);
            border-bottom: 1px solid var(--border-soft);
            flex-wrap: wrap;
        }
        .brand {
            display: inline-flex; align-items: center; gap: 10px;
            font-family: var(--mono); font-weight: 700; font-size: 14px;
            letter-spacing: .06em; color: var(--text);
            text-decoration: none; margin-right: auto;
        }
        .brand-mark {
            width: 28px; height: 28px; border-radius: 7px;
            background: var(--accent); display: grid; place-items: center;
        }
        .brand-mark svg { width: 17px; height: 17px; }
        .nav-links { display: flex; gap: 4px; }
        .nav-link {
            color: var(--text-dim); text-decoration: none;
            font-size: 14px; padding: 7px 13px; border-radius: 8px;
            transition: background .18s ease, color .18s ease;
            white-space: nowrap;
        }
        .nav-link:hover { color: var(--text); background: var(--surface-2); }
        .nav-link.active { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
        .container {
            position: relative; z-index: 1;
            width: 100%; max-width: 1180px; margin: 0 auto;
            padding: clamp(18px, 4vw, 36px);
            flex: 1;
        }
        .eyebrow {
            font-family: var(--mono); font-size: 12px;
            letter-spacing: .14em; text-transform: uppercase;
            color: var(--accent); margin-bottom: 8px; font-weight: 600;
        }
        h1 { letter-spacing: -.01em; }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
        /* 入场动画已移除：内容默认可见，避免低性能/特殊渲染环境下卡在透明态 */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
        }
        @media (max-width: 480px) {
            .app-nav { padding: 9px 12px; }
            .nav-link { font-size: 13px; padding: 6px 9px; }
            .brand { font-size: 13px; }
        }
        {% block extra_css %}{% endblock %}
    </style>
</head>
<body>
    <header class="app-nav">
        <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5-6 4 3 5-7 4 4"/></svg>
            </span>
            <span>STOCK<span style="color:var(--accent)">·</span>SAVE</span>
        </a>
        <nav class="nav-links" aria-label="主导航">
            <a class="nav-link" href="/" data-nav="/">总览</a>
            <a class="nav-link" href="/cookie" data-nav="/cookie">Cookie 管理</a>
            <a class="nav-link" href="/chart?mode=trend" data-nav="/chart" data-mode="trend">连续趋势</a>
            <a class="nav-link" href="/chart?mode=compare" data-nav="/chart" data-mode="compare">多轴对比</a>
        </nav>
    </header>
    <main class="container">
        {% block content %}{% endblock %}
    </main>
    {% block extra_js %}{% endblock %}
    <script>
        (function () {
            var path = location.pathname;
            var mode = new URLSearchParams(location.search).get('mode') || 'trend';
            document.querySelectorAll('.nav-link').forEach(function (a) {
                var samePath = a.getAttribute('data-nav') === path;
                var wanted = a.getAttribute('data-mode');
                if (samePath && (!wanted || wanted === mode)) a.classList.add('active');
            });
        })();
    </script>
</body>
</html>
