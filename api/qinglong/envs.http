### 获取 Token
# @name getToken
GET {{BASE_URL}}/open/auth/token?client_id={{CLIENT_ID}}&client_secret={{CLIENT_SECRET}}
Accept: application/json

# response
# {
#   "code": 200,
#   "data": {
#     "token": "0e22d492-7510-4463-9d83-8514816dd7f4",
#     "token_type": "Bearer",
#     "expiration": 1773042629
#   }
# }


### 获取环境变量

# @name getEnvs
# @ref getToken
GET {{BASE_URL}}/open/envs?searchValue=BJXD1
Accept: application/json
Authorization: Bearer {{getToken.data.token}}

# response
# {
#   "code": 200,
#   "data": [
#     {
#       "id": 2,
#       "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9",
#       "timestamp": "Thu Jan 29 2026 12:23:29 GMT+0800 (China Standard Time)",
#       "status": 0,
#       "position": 4499980000000000,
#       "name": "BJXD1",
#       "remarks": "BJXD 潇鸿130 账号",
#       "isPinned": 0,
#       "createdAt": "2024-12-13T17:23:09.402Z",
#       "updatedAt": "2026-01-29T04:23:29.145Z"
#     }
#   ]
# }

### 创建环境变量

# @name createEnv
# @ref getToken

POST {{BASE_URL}}/open/envs
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{getToken.data.token}}

[
  {
    "name": "TEST2",
    "value": "TEST2 VALUE",
    "remarks": "TEST2 REMARKS"
  }
]

# response
# {
#   "code": 200,
#   "data": [
#     {
#       "id": 19,
#       "value": "TEST VALUE",
#       "status": 0,
#       "timestamp": "Sat Feb 07 2026 16:49:22 GMT+0800 (China Standard Time)",
#       "position": 4499830000000000,
#       "name": "TEST",
#       "remarks": "TEST REMARKS",
#       "isPinned": 0,
#       "updatedAt": "2026-02-07T08:49:22.264Z",
#       "createdAt": "2026-02-07T08:49:22.264Z"
#     }
#   ]
# }

### 更新环境变量
# @name updateEnv
# @ref getEnvs
# @ref getToken
PUT {{BASE_URL}}/open/envs
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{getToken.data.token}}

{
  "id": {{getEnvs.data[0].id}},
  "name": "{{getEnvs.data[0].name}}",
  "value": "{{getEnvs.data[0].value}}",
  "remarks": "{{getEnvs.data[0].remarks}} Test"
}

# response
# {
#   "code": 200,
#   "data": {
#     "id": 2,
#     "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9",
