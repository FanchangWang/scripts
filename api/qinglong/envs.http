### 删除环境变量

# @name deleteEnv
# @ref getToken
DELETE {{BASE_URL}}/open/envs
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{getToken.data.token}}

[19, 20]

# response
# {
#   "code": 200
# }
