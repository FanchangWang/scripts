.DS_Store

# ============================================================
# 环境变量 / 密钥（保留 .env.example 模板）
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Python（pip / uv）
# ============================================================
# 虚拟环境
.venv/
venv/
env/
ENV/

# 编译产物 / 缓存
__pycache__/
*.py[cod]
*.pyo
*.so

# 打包 / 分发
build/
dist/
*.egg-info/
*.egg
.eggs/

# 测试 / 覆盖率 / lint / 类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Jupyter
.ipynb_checkpoints/

# 依赖锁（按需忽略 uv.lock；通常建议提交以锁定可复现环境）
uv.lock

# ============================================================
# Android
# ============================================================
# build/ 已在上方 Python 段统一忽略（匹配任意层级）
release/

# 原生构建
.externalNativeBuild/
.cxx/

# Gradle
.gradle/
gradle-app.setting

# IDE
*.iml
.idea/
captures/

# 本地配置
local.properties

# 签名密钥（绝不可提交！）
*.keystore
*.jks

# 内存 dump
*.hprof

# ============================================================
# 工具 / 其他
# ============================================================
# PyInstaller 规格文件
*.spec

# WorkBuddy 工作区数据
.workbuddy/
