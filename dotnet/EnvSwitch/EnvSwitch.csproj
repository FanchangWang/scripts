<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 程序只跑 Windows：注册表 API 都在 Windows 上，用 -windows TFM 才能被编译器正确识别 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EnvSwitch</RootNamespace>
    <AssemblyName>EnvSwitch</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- 单文件绿色 exe 的发布参数：dotnet publish 时生效 -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- 只要一个 exe，不产生 web.config 与静态资源清单 -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <GenerateStaticWebAssetsEndpointsManifest>false</GenerateStaticWebAssetsEndpointsManifest>
  </PropertyGroup>

  <!-- 网页 UI 作为嵌入资源，单文件发布后不需要任何外部文件 -->
  <ItemGroup>
    <EmbeddedResource Include="Ui\ui.html" LogicalName="EnvSwitch.Ui.ui.html" />
  </ItemGroup>

  <!-- 清理 ASP.NET Web SDK 额外生成的清单文件，发布目录只留 exe -->
  <Target Name="RemoveExtraPublishFiles" AfterTargets="Publish">
    <Delete Files="$(PublishDir)$(TargetName).staticwebassets.endpoints.json" />
  </Target>

</Project>
