# 一个 user token 用下面这种方式
BJXD=xxxxx

# 多个 user token 用下面这种方式
BJXD1=xxxxx
BJXD2=xxxxx
BJXD3=xxxxx
BJXD4=xxxxx

# 预设答案(值: A/B/C/D)
BJXD_ANSWER=x

# 开启 AI 功能
AI_API_KEY=ai api key
AI_REQUEST_URL=ai 请求地址
AI_MODEL=ai 模型
AI_REQUEST_PARAMS=ai 请求参数（可空，JSON字符串格式）

# 腾讯混元大模型 API 请求格式
# AI_REQUEST_URL=https://api.hunyuan.cloud.tencent.com/v1/chat/completions
# AI_MODEL=hunyuan-turbo
# AI_REQUEST_PARAMS='{"enable_enhancement": true, "force_search_enhancement": true, "enable_instruction_search": true}'

# 智谱 AI bigmodel.cn API 请求格式
# AI_REQUEST_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# AI_MODEL=glm-4.5-flash
# AI_REQUEST_PARAMS='{"do_sample": false}'

# 联网搜索（先用题干搜资料，再随题目一起提交给 AI，提升无内置搜索模型的正确率）
# 渠道：百度 AI 搜索（千帆），官方 API、国内直连、中文效果好，每月免费 1500 次（约每天 50 次）
# 申请：百度智能云实名认证 → 控制台创建 API Key（形如 bce-v3/ALTAK-xxxx/xxxx）
#       https://console.bce.baidu.com/ai-search/qianfan/ais/console/apiKey
SEARCH_API_KEY=
# 搜索结果条数（默认 5）
SEARCH_RESULT_COUNT=5
# 搜索超时秒数（默认 30）
SEARCH_TIMEOUT=30

# 腾讯混元大模型 API Key # 已废弃，请使用 AI_XXXX 定义通用 AI
HUNYUAN_API_KEY=sk-xxxxx

# 智谱 AI bigmodel.cn API Key # 已废弃，请使用 AI_XXXX 定义通用 AI
GLM_API_KEY=xxxxx
